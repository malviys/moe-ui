{
  "name": "moe-ui",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "types:check": "turbo types:check",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "registry:generate": "pnpm --filter docs registry:generate",
    "registry:check": "pnpm --filter docs registry:check",
    "dev:docs": "turbo dev --filter=docs",
    "build:docs": "turbo build --filter=docs",
    "start:docs": "pnpm --filter docs start"
  },
  "peerDependencies": {},
  "dependencies": {},
  "devDependencies": {
    "turbo": "^2.8.9"
  }
}
