{
  "name": "moe-ui",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm types:check",
    "types:check": "turbo types:check",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "registry:generate": "pnpm --filter docs registry:generate",
    "registry:check": "pnpm --filter docs registry:check",
    "dev:docs": "turbo dev --filter=docs",
    "build:docs": "turbo build --filter=docs",
    "start:docs": "pnpm --filter docs start",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10",
    "husky": "^9",
    "prettier": "^3",
    "turbo": "^2.8.9"
  }
}
