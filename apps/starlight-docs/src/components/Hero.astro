---
/**
 * Custom Hero component for Moe UI docs homepage.
 * Overrides Starlight's default Hero with a modern, minimalistic design.
 */

const { data } = Astro.locals.starlightRoute.entry;
const isHomepage = Astro.locals.starlightRoute.slug === '';
---

{isHomepage ? (
  <div class="hero-section">
    {/* Background dot grid */}
    <div class="dot-grid" style="position:absolute;inset:0;pointer-events:none;z-index:0;" aria-hidden="true"></div>
    
    {/* Radial gradient glow */}
    <div style="position:absolute;top:-20%;left:50%;transform:translateX(-50%);width:80%;height:60%;background:radial-gradient(ellipse at center, var(--sl-color-accent-low) 0%, transparent 70%);opacity:0.4;pointer-events:none;z-index:0;" aria-hidden="true"></div>

    {/* Announcement badge */}
    <a href="/components/accordion/" class="hero-announce animate-fade-in-up" style="position:relative;z-index:1;">
      <span>Browse 50+ Components</span>
      <span aria-hidden="true">→</span>
    </a>

    {/* Title */}
    <h1 class="hero-title animate-fade-in-up animation-delay-100" style="position:relative;z-index:1;">
      Build your Universal<br/>Component Library
    </h1>

    {/* Tagline */}
    <p class="hero-tagline animate-fade-in-up animation-delay-200" style="position:relative;z-index:1;">
      Bringing <strong style="color:var(--sl-color-text);font-weight:500;">shadcn/ui</strong> to React Native. Beautifully crafted, accessible components with NativeWind — open source and almost as easy to use.
    </p>

    {/* CTA buttons */}
    <div class="hero-actions animate-fade-in-up animation-delay-300" style="position:relative;z-index:1;">
      <a href="/introduction/" class="hero-btn-primary">
        Get Started
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="/components/accordion/" class="hero-btn-secondary">
        Browse Components
      </a>
    </div>

    {/* Source badges */}
    <div class="animate-fade-in-up animation-delay-400" style="display:flex;flex-wrap:wrap;justify-content:center;gap:0.5rem;position:relative;z-index:1;">
      <span class="source-badge shadcn">shadcn/ui</span>
      <span class="source-badge reui">ReUI</span>
      <span class="source-badge rnr">RNR</span>
      <span class="source-badge nativewind">NativeWind</span>
    </div>

    {/* Stats */}
    <div class="stats-row animate-fade-in-up animation-delay-500" style="position:relative;z-index:1;">
      <div class="stat-item">
        <span class="stat-number">50+</span>
        <span class="stat-label">Components</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">3</span>
        <span class="stat-label">Platforms</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">100%</span>
        <span class="stat-label">Open Source</span>
      </div>
    </div>
  </div>
) : (
  <slot />
)}
