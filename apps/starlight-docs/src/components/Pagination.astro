---
import { Icon } from '@astrojs/starlight/components';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';
---

<div class="pagination-links print:hidden" dir={dir}>
	{
		prev && (
			<a href={prev.href} rel="prev" class="pagination-card">
				<Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="1.25rem" />
				<span class="flex flex-col">
					<span class="label">{Astro.locals.t('page.previousLink')}</span>
					<span class="link-title">{prev.label}</span>
				</span>
			</a>
		)
	}
	{
		next && (
			<a href={next.href} rel="next" class="pagination-card text-right flex-row-reverse">
				<Icon name={isRtl ? 'left-arrow' : 'right-arrow'} size="1.25rem" />
				<span class="flex flex-col">
					<span class="label">{Astro.locals.t('page.nextLink')}</span>
					<span class="link-title">{next.label}</span>
				</span>
			</a>
		)
	}
</div>

<style>
	.pagination-links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
		gap: 0.5rem;
		margin-top: 2rem;
	}

	.pagination-card {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.5rem;
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem; /* rounded-md */
		padding: 0.75rem 1rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		box-shadow: var(--sl-shadow-sm);
		overflow-wrap: anywhere;
		transition: border-color 0.2s, background-color 0.2s;
	}

	.pagination-card:hover {
		border-color: var(--sl-color-gray-3);
		background-color: var(--sl-color-gray-6);
	}

	.label {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		line-height: normal;
	}

	.link-title {
		color: var(--sl-color-white);
		font-size: var(--sl-text-base);
		font-weight: 500;
		line-height: normal;
	}

	svg {
		flex-shrink: 0;
		color: var(--sl-color-gray-3);
	}

	.pagination-card:hover svg {
		color: var(--sl-color-white);
	}
</style>
