{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm registry:generate",
    "build": "next build --webpack",
    "dev": "next dev --webpack",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "registry:generate": "node --import tsx scripts/generate-registry.ts",
    "registry:check": "node --import tsx scripts/generate-registry.ts --check"
  },
  "dependencies": {
    "@moe-ui/registry": "workspace:*",
    "@orama/orama": "^3.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.5.1",
    "fumadocs-docgen": "^3.0.8",
    "fumadocs-mdx": "14.2.6",
    "fumadocs-ui": "16.5.1",
    "geist": "^1.7.2",
    "lucide-react": "^0.563.0",
    "lucide-react-native": "0.563.0",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-native": "0.83.1",
    "react-native-web": "^0.21.2",
    "tailwind-merge": "^3.5.0",
    "uniwind": "^1.11.0",
    "uniwind-plugin-next": "1.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
